# Extra values for the geo pipeline (docker-compose.geo.yml).
# Add them to the host's .env (/opt/gates-demo/app/.env on the EC2 instance).
# Do not commit real values.

# Passwords: required. Generate each one, for example with: openssl rand -base64 24
GEO_DB_PASSWORD=
GEOSERVER_ADMIN_PASSWORD=

# Optional, shown with their defaults.
# GEO_DB_USER=gates_geo
# GEO_DB_NAME=gates_geo
# GEOSERVER_ADMIN_USER=admin

# Set earlier for OpenBao (step S1).
# GATES_DATA_ROOT=/opt/gates-demo/data
# GATES_ENV=aws
# OPENBAO_POC_ACK=yes
